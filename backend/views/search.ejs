<!DOCTYPE html>
<html lang="id">
<head>
    <title>Hasil Pencarian - Makan Ki'</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <nav>
        <div class="logo"><a href="/" style="color:white; text-decoration:none;">MAKAN KI'</a></div>
    </nav>

    <div class="container" style="margin-top: 20px;">
        <h2>🔍 Hasil Pencarian: "<%= keyword %>" <%= city ? 'di ' + city : '' %></h2>
        
        <% if(results.length === 0) { %>
            <p>Maaf, kuliner tidak ditemukan. Coba kata kunci lain!</p>
        <% } else { %>
            <div class="grid">
                <% results.forEach(item => { %>
                    <div class="card">
                        <div class="card-img" style="background-color: #ddd; height: 150px;"></div>
                        <div class="card-body">
                            <h3><%= item.nama %></h3>
                            <p><%= item.desc %></p>
                            <p><b><%= item.harga %></b></p>
                            <a href="/detail/<%= item.id %>" class="btn">Lihat Menu</a>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
        <br>
        <a href="/" class="btn-secondary">Kembali ke Beranda</a>
    </div>
</body>
</html>