<!DOCTYPE html>
<html lang="id">
<head>
    <title><%= item.nama %> - Detail</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <nav><div class="logo">MAKAN KI'</div></nav>
    
    <div class="container detail-page">
        <div class="detail-header">
            <h1><%= item.nama %></h1>
            <span class="badge"><%= item.kategori %></span>
            <span class="badge"><%= item.kota %></span>
        </div>

        <div class="detail-content">
            <div class="main-img" style="background: #eee; height: 300px; border-radius: 10px; margin-bottom: 20px;"></div>
            
            <h3>Deskripsi</h3>
            <p><%= item.desc %></p>
            
            <h3>Info</h3>
            <ul>
                <li>💰 Harga: <%= item.harga %></li>
                <li>⭐ Rating: <%= item.rating %>/5.0</li>
            </ul>

            <!-- === AREA PETA GOOGLE MAPS === -->
            <h3 style="margin-top: 30px;">📍 Lokasi</h3>
            
            <!-- 1. Wadah Peta (Wajib ada ID "map") -->
            <div id="map" style="width: 100%; height: 350px; border-radius: 15px; margin-top: 10px; border: 2px solid #ddd;"></div>

            <!-- 2. Tombol Navigasi -->
            <div style="margin-top: 20px;">
                <a href="https://www.google.com/maps/dir/?api=1&destination=<%= item.lat %>,<%= item.lng %>" target="_blank" class="btn">
                    🚗 Buka Rute (Google Maps)
                </a>
                <a href="/" class="btn-secondary">Kembali</a>
            </div>
        </div>
    </div>

    <!-- === SCRIPT PETA === -->
    <script>
        function initMap() {
            // 1. Ambil koordinat dari Database (lewat EJS)
            // Jika data kosong, default ke Jakarta (-6.2, 106.8)
            const latitude = <%= item.lat || -6.200000 %>;
            const longitude = <%= item.lng || 106.816666 %>;
            const lokasi = { lat: latitude, lng: longitude };

            // 2. Munculkan Peta
            const map = new google.maps.Map(document.getElementById("map"), {
                zoom: 16, // Semakin besar angka, semakin nge-zoom
                center: lokasi,
            });

            // 3. Pasang Pin (Marker) Merah
            const marker = new google.maps.Marker({
                position: lokasi,
                map: map,
                title: "<%= item.nama %>", // Muncul saat mouse diarahin ke pin
                animation: google.maps.Animation.DROP // Efek pin jatuh
            });
        }
    </script>

    <!-- 
      LOAD API GOOGLE MAPS 
      Ganti 'YOUR_API_KEY' dengan API Key kamu sendiri nanti.
      Untuk sekarang kosongkan saja, peta tetap muncul (mode developer).
    -->
    <script src="https://maps.googleapis.com/maps/api/js?key=&callback=initMap" async defer></script>

</body>
</html>