<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Makan Ki' - Jelajah Kuliner</title>
    <link rel="stylesheet" href="/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <!-- Navbar -->
    <nav>
        <div class="logo">MAKAN KI' 🍲</div>
        <ul>
            <li><a href="/">Beranda</a></li>
            <li><a href="/search">Cari Makan</a></li>
            <li><a href="#">Login</a></li>
        </ul>
    </nav>

    <!-- Hero Section -->
    <header class="hero">
        <h1>Mau makan apa hari ini?</h1>
        <p>Temukan kuliner terbaik di kota Anda</p>
        
        <form action="/search" method="GET" class="search-box">
            <select name="city">
                <option value="">Semua Kota</option>
                <option value="Medan">Medan</option>
                <option value="Palembang">Palembang</option>
                <option value="Jakarta">Jakarta</option>
                <option value="Surabaya">Surabaya</option>
                <option value="Balikpapan">Balikpapan</option>
                <option value="Pontianak">Pontianak</option>
                <option value="Makassar">Makassar</option>
                <option value="Manado">Manado</option>
                <option value="Jayapura">Jayapura</option>
                <option value="Sorong">Sorong</option>
            </select>
            <input type="text" name="q" placeholder="Cari 'Coto', 'Bakso'...">
            <button type="submit">Cari</button>
        </form>
    </header>

    <!-- Rekomendasi -->
    <section class="container">
        <h2>🔥 Rekomendasi Terpopuler</h2>
        <div class="grid">
            <% data.forEach(item => { %>
                <div class="card">
                    <div class="card-img" style="background-color: #ddd; height: 150px; display:flex; align-items:center; justify-content:center;">
                        Foto: <%= item.nama %>
                    </div>
                    <div class="card-body">
                        <h3><%= item.nama %></h3>
                        <span class="badge"><%= item.kota %></span>
                        <p>⭐ <%= item.rating %> | <%= item.harga %></p>
                        <a href="/detail/<%= item.id %>" class="btn">Lihat Detail</a>
                    </div>
                </div>
            <% }) %>
        </div>
    </section>
</body>
</html>